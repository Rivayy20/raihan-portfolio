# Existing Web3Forms Contact Form Key (NEVER store in Supabase database)
VITE_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key

# Supabase Public Client Configuration (Protected by RLS & Column-Level Grants)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Public data resilience switches
# Keep VITE_USE_STATIC_FALLBACK=true so transient network errors gracefully render static fallback data.
VITE_USE_STATIC_FALLBACK=true
# Set VITE_FORCE_STATIC_MODE=true only as an emergency kill-switch to bypass Supabase completely.
VITE_FORCE_STATIC_MODE=false

# Optional server-side aliases for Vercel Serverless Meta Injector (`api/render-home.js`).
# If omitted on Vercel, `api/render-home.js` automatically reads `VITE_SUPABASE_URL` and `VITE_SUPABASE_PUBLISHABLE_KEY`.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
